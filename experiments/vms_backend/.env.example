# Copy to .env; điền thông tin được cấp. Không commit .env.
VMS_MQTT_HOST=aioc-stg.atin.vn
VMS_MQTT_USERNAME=
VMS_MQTT_PASSWORD=
# Optional: IP nội bộ đã xác nhận; vẫn kiểm TLS theo hostname.
VMS_BROKER_IP=
VMS_ZONE_ID=
VMS_CAMERA_CODE=
VMS_CAMERA_ID=
# Để trống nếu chưa biết; chạy case01 để tìm từ company topic rồi điền vào đây.
VMS_ORGANIZATION_ID=
VMS_MODULE=FIGHT_DETECTION
